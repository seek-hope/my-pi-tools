{
	"name": "pi-deepseek-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Pi extension: web_search and web_fetch tools backed by DeepSeek and Exa",
	"engines": {
		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "node --test test/*.test.ts",
		"smoke": "node scripts/smoke.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"@types/node": "^22.10.0",
		"typebox": "1.3.27",
		"typescript": "^5.9.0"
	}
}
