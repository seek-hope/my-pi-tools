{
  "name": "my-pi-helper",
  "version": "0.1.0",
  "description": "Independent, request-scoped assistance for Pi with read and work modes",
  "type": "module",
  "private": true,
  "license": "MIT",
  "keywords": ["pi-package", "pi", "helper"],
  "pi": { "extensions": ["./extensions/index.ts"] },
  "files": ["extensions", "src", "README.md", "README.zh-CN.md", "DESIGN.md"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts' 'extensions/**/*.ts' 'test/*.mjs' 'scripts/*.mjs'",
    "check:format": "prettier --check 'src/**/*.ts' 'extensions/**/*.ts' 'test/*.mjs' 'scripts/*.mjs'",
    "check:compat": "node scripts/check-compat.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.3.0 || 1.4.0",
    "@earendil-works/pi-coding-agent": "1.3.0 || 1.4.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "engines": { "node": ">=22.19.0" },
  "piCompatibility": { "current": "1.4.0", "previous": "1.3.0" }
}
