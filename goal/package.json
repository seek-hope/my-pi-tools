{
  "name": "my-pi-goal",
  "version": "0.1.0",
  "description": "Durable autonomous goals for Pi with explicit evidence and independent verification",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "pi",
    "goal"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "files": [
    "extensions",
    "src",
    "docs",
    "verification",
    "scripts",
    "examples",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "tsc --noEmit",
    "dev:link-host": "node scripts/link-host.mjs",
    "format": "prettier --write 'src/**/*.ts' 'extensions/**/*.ts' 'test/*.mjs' 'scripts/*.mjs'",
    "check:format": "prettier --check 'src/**/*.ts' 'extensions/**/*.ts' 'test/*.mjs' 'scripts/*.mjs'",
    "check:load": "node scripts/check-load.mjs",
    "verify:setup": "node scripts/verify-formal.mjs --setup",
    "verify:formal": "node scripts/verify-formal.mjs",
    "verify:evidence": "node scripts/verify-formal.mjs --check-evidence",
    "check:compat": "node scripts/check-compat.mjs",
    "verify:coverage": "node scripts/verify-coverage.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.3.0 || 1.4.0",
    "@earendil-works/pi-coding-agent": "1.3.0 || 1.4.0",
    "@earendil-works/pi-tui": "1.3.0 || 1.4.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "piCompatibility": {
    "current": "1.4.0",
    "previous": "1.3.0"
  }
}
