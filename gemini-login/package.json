{
  "name": "my-pi-gemini-login",
  "version": "0.3.0",
  "description": "Antigravity ACP client for Pi",
  "type": "module",
  "private": true,
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "gemini",
    "antigravity",
    "acp"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --test-timeout=15000 test/*.test.mjs",
    "check:format": "prettier --check 'src/**/*.ts' 'test/*.mjs'",
    "format": "prettier --write 'src/**/*.ts' 'test/*.mjs'"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.4.0",
    "ajv": "8.20.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": ">=1.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
