{
  "name": "my-pi-gemini-login",
  "version": "0.1.0",
  "description": "Legacy Google Code Assist OAuth provider for Pi",
  "type": "module",
  "private": true,
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "gemini",
    "oauth"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "check:format": "prettier --check 'src/**/*.{ts,mjs}' 'test/*.mjs'",
    "format": "prettier --write 'src/**/*.{ts,mjs}' 'test/*.mjs'"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.5.0",
    "@earendil-works/pi-coding-agent": ">=1.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
