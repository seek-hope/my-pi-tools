[Unit]
Description=更新 agent 技能与 CLI 工具
Documentation=file:%h/.local/state/scientific-skills-check/last-report.txt
Documentation=file:%h/.local/state/pi-toolchain-updates/last-report.txt

[Service]
Type=oneshot
TimeoutStartSec=1800
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Environment=PATH=%h/.local/bin:%h/.local/share/pi-node/current/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/.local/bin/update-pi-toolchain
